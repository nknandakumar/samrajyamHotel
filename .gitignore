# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js Build and Cache
/.next/
/out/

# Production Build Output
/build

# Testing Coverage
/coverage

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local Environment Files
# Next.js recommends committing default templates (.env, .env.production) 
# but strictly ignoring local files that contain actual secrets.
.env*.local

# Vercel Deployment Metadata
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Optional: IDE and System files
.DS_Store
.vscode/
.idea/
